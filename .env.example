# Copy this file to .env and fill in your own values. Never commit the real .env file.

# --- SQLite database file ---
# Relative or absolute path. The file (and its tables) is created automatically
# on server startup or via: python main.py init-db
SQLITE_DB_PATH=jeopardy.db

# --- Admin token, required to enable /api/admin/* endpoints (opentdb pulls). ---
# --- Leave blank to disable those endpoints entirely.                       ---
# --- Set this to something long and random before deploying publicly.      ---
ADMIN_TOKEN=

# --- Web server bind address/port (used by uvicorn if not passed on the CLI) ---
HOST=0.0.0.0
PORT=8000

# --- Open Trivia DB has no key requirement, nothing to set here ---
